# --- Centras Chat gateway (server only; never shipped to clients) -----------------------------
# Public address employees enter in the app / that the web build is served under.
GATEWAY_DOMAIN=chat.example.com
GATEWAY_PUBLIC_URL=https://chat.example.com
GATEWAY_PORT=8080
# Comma-separated browser origins allowed to call /api/*; the desktop app needs no entry.
CORS_ORIGINS=https://chat.example.com

# Supabase project the gateway fronts. The anon key is injected into proxied requests;
# the service role key is used only inside the gateway (bot, outbox, admin views).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integration bot: external systems POST /api/v1/integrations/messages with this bearer token;
# messages are attributed to the profile below (create a "Система" employee for it).
INTEGRATION_BOT_TOKEN=
INTEGRATION_BOT_USER_ID=

# Generic outbound webhook consumer of integration_outbox (HMAC-SHA256 signed). Leave empty to
# keep events queued for inspection only.
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20

# Telegram relay (optional) — see docs/TELEGRAM_SETUP.md; the worker runs inside the gateway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_SECRET=
TELEGRAM_WEBHOOK_URL=https://chat.example.com/api/telegram/webhook
TELEGRAM_WORKER_INTERVAL_MS=60000

# Clients older than this see "Обновите приложение" (compared with package.json version).
MIN_CLIENT_VERSION=1.0.0
