{
  "name": "corporate-chat",
  "version": "1.0.0",
  "description": "Centras Corporate Chat Client",
  "author": "Centras",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "desktop:compile": "tsc -p electron/tsconfig.json",
    "desktop:dev": "concurrently -k \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:build": "next build && tsc -p electron/tsconfig.json",
    "build:installer": "tsx scripts/build-installer.ts",
    "icons": "node scripts/generate-icons.mjs",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:build": "node server/build.mjs",
    "server:start": "node dist-server/index.js",
    "server:dev": "node server/build.mjs && node dist-server/index.js",
    "verify": "tsc --noEmit -p tsconfig.json && tsc -p electron/tsconfig.json --noEmit && tsc -p server/tsconfig.json && vitest run && next build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "lucide-react": "^0.395.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  }
}
